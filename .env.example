# ---------- Server ----------
PORT=4242
# Public URL of the site (used for Stripe redirects)
SITE_URL=http://localhost:5173

# ---------- Stripe (cards, Google Pay, Apple Pay, Link) ----------
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional: https://dashboard.stripe.com/test/webhooks  (endpoint: /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=

# ---------- PayPal ----------
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox

# Leave the keys blank to run the full booking flow in DEMO mode (no real charges).
