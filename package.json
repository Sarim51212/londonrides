{
  "name": "london-rides",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "London Rides - luxury chauffeur & airport transfer booking platform",
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,cyan \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "optimize-media": "node scripts/optimize-media.js"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.6.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
